* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.bat text eol=crlf
*.docx binary
*.xlsx binary
*.png binary
# Fixture manifests pin exact bytes; never normalize bundled source data.
data/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Contract copies must stay byte-identical to upstream on any checkout:
# line-ending normalization would invalidate the SHA-256 records in
# web/public/contracts/PROVENANCE.md.
web/public/contracts/** -text
# A3 contract test samples are byte-frozen copies too.
web/tests/fixtures/** -text

# Public demo assets also retain their reviewed bytes.
web/public/demo/** -text
# These HTML/robots inputs reproduce the frozen v3 delivery bytes on checkout.
web/index.html -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
web/public/robots.txt -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
web/worker/serve-public.mjs -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
